{
  "$schema": "https://raw.githubusercontent.com/nicegui-dev/tauri/refs/heads/dev/.schema/config.schema.json",
  "productName": "Zemax Agent",
  "version": "0.1.0",
  "identifier": "com.zemax-agent.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "title": "Zemax Agent",
    "windows": [
      {
        "title": "Zemax Agent — Optical Engineering Workspace",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
